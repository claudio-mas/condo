{
  "name": "condo",
  "version": "0.1.0",
  "private": true,
  "description": "Plataforma Comercial Hoteleira — beta",
  "type": "module",
  "engines": {
    "node": ">=24.12.0 <25"
  },
  "scripts": {
    "dev": "next dev",
    "start": "next start",
    "build": "next build",
    "typecheck": "next typegen && tsc --noEmit",
    "lint": "eslint .",
    "test": "vitest run --config vitest.config.ts",
    "test:integration": "vitest run --config vitest.integration.config.ts",
    "test:e2e": "playwright test",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "bootstrap:admin": "node scripts/bootstrap-admin.ts",
    "invite:company": "node scripts/invite-company.ts",
    "prepare:initial-data": "node scripts/prepare-initial-data.ts",
    "seed:demo": "node scripts/seed-demo.ts",
    "diagnose:issuance": "node scripts/diagnose-issuance.ts",
    "clean:orphans": "node scripts/clean-orphans.ts",
    "backup": "node scripts/backup.ts",
    "restore:check": "node scripts/restore-check.ts",
    "reconcile:links": "node scripts/reconcile-restored-links.ts",
    "reconcile:access": "node scripts/reconcile-restored-access.ts",
    "measure:beta": "node scripts/measure-beta.ts"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "3.1172.0",
    "@better-auth/drizzle-adapter": "1.7.26",
    "@pdf-lib/fontkit": "1.1.1",
    "better-auth": "1.7.26",
    "decimal.js": "10.6.0",
    "drizzle-orm": "0.45.4",
    "next": "16.4.6",
    "nodemailer": "10.6.0",
    "pdf-lib": "1.17.1",
    "pg": "8.23.1",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "server-only": "0.0.1",
    "sharp": "0.35.5",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@playwright/test": "1.65.1",
    "@types/node": "24.19.2",
    "@types/nodemailer": "8.0.2",
    "@types/pg": "8.23.1",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "drizzle-kit": "0.31.11",
    "eslint": "9.39.5",
    "eslint-config-next": "16.4.6",
    "pdfjs-dist": "6.5.438",
    "typescript": "5.9.3",
    "vitest": "5.1.1"
  }
}
