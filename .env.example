# Modelo de configuração — SOMENTE EXEMPLOS DE DESENVOLVIMENTO.
# Nenhum valor abaixo é segredo real. Copie para .env.local e ajuste localmente.

# Ambiente: development | test | production
APP_ENV=development
# Origem pública da aplicação (desenvolvimento)
APP_ORIGIN=http://localhost:3000

# Banco operacional de desenvolvimento (exemplo local)
DATABASE_URL=postgres://condo:condo-dev-only@localhost:5432/condo_dev
# Banco isolado para testes de integração — nunca aponte para banco operacional
TEST_DATABASE_URL=postgres://condo:condo-dev-only@localhost:5432/condo_test

# Identidade (Better Auth) — gere um valor local; exemplo NÃO é segredo
BETTER_AUTH_SECRET=dev-only-change-me-at-least-32-characters
BETTER_AUTH_URL=http://localhost:3000

# Chave de cifra dos links públicos (AES-GCM, 32 bytes em base64) — exemplo de desenvolvimento
PROPOSAL_LINK_KEY=ZGV2LW9ubHktZXhhbXBsZS1rZXktMzItYnl0ZXMhISE=

# Armazenamento privado compatível com S3 (exemplo local)
STORAGE_ENDPOINT=http://localhost:9000
STORAGE_REGION=us-east-1
STORAGE_BUCKET=condo-dev
STORAGE_ACCESS_KEY_ID=dev-only-access-key
STORAGE_SECRET_ACCESS_KEY=dev-only-secret-key

# SMTP transacional (ativação e recuperação) — exemplo local
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=no-reply@example.test

# Manutenção operacional (configuração externa ao banco restaurado)
MAINTENANCE_MODE=off
